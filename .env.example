# SMTP Email Configuration
# For Gmail: use smtp.gmail.com, port 587, and an App Password (not your regular password)
# To generate an App Password: Google Account → Security → 2-Step Verification → App Passwords

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# The email address where contact form submissions will be sent
MAIL_TO=areejhwahid@gmail.com
