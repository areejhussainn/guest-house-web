# Email Configuration (Resend — https://resend.com)
# 1. Create a free account, add & verify the rasgrand.com domain (add the DNS
#    records Resend gives you in Cloudflare).
# 2. Create an API key at resend.com/api-keys and paste it below.

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Verified sender. The domain part MUST be a domain you've verified in Resend.
MAIL_FROM=Ras Grand <hello@rasgrand.com>

# Where contact form submissions are delivered.
MAIL_TO=hello@rasgrand.com
